# ┌─────────────────────────────────────────────────────────────────────────┐
# │  Supabase Configuration                                                │
# │                                                                        │
# │  Get these values from: Supabase Dashboard → Settings → Database       │
# │  and: Supabase Dashboard → Settings → API                             │
# └─────────────────────────────────────────────────────────────────────────┘

# Connection string from Supabase Dashboard → Settings → Database → Connection string (URI)
# Use the "Transaction" pooler (port 6543) for your app, or "Session" pooler for migrations.
#
# Set EITHER this or CLOUD_SQL_INSTANCE (a Cloud SQL connection name, used by
# the Google connector instead of a direct URL) — never both. The app refuses
# to start when both are set rather than picking one, because guessing meant
# scripts silently connected to the wrong database.
#
# To aim a single command at a different database without editing this file,
# set DB_TARGET — blanking a variable on the command line does NOT work, since
# settings ignore empty values and fall back to what is here:
#   DB_TARGET=url POSTGRES_DB_URL="postgresql://localhost/scratch" alembic upgrade head
POSTGRES_DB_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# JWT secret for verifying Supabase Auth tokens.
# Find it in: Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-super-secret-jwt-token-from-supabase-dashboard

# Supabase API (for frontend JS client and optional supabase-py)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Set to True when using Supavisor/pgBouncer (port 6543) — disables prepared statements
DB_USE_CONNECTION_POOLER=True

# Local Docker Postgres (fallback)


# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=changethis
# POSTGRES_DB=app

# App Settings


PROJECT_NAME="PC Build Recommender"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

ENVIRONMENT=local
FRONTEND_HOST=http://localhost:5173

BACKEND_CORS_ORIGINS=http://localhost:5173

NEXT_PUBLIC_SECRET_MESSAGE_1=67
NEXT_PUBLIC_SECRET_MESSAGE_0=69

# Tracing (optional — both halves are independently optional)


# LangSmith receives the LLM and graph spans only. Leave blank and that
# exporter is never attached, which is the normal local setup.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=palladium

# Everything else (request spans, DB spans) goes to whatever OTLP collector
# this points at. On GKE, Managed OpenTelemetry injects it — do not set it
# there. Locally, point it at a collector container if you want Cloud Trace
# parity; unset means no export at all.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
