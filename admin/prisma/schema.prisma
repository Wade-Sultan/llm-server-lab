generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PcPart {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  manufacturer     String?
  modelNumber      String?  @map("model_number")
  yearReleased     Int?     @map("year_released")
  partType         String   @map("part_type")
  isActive         Boolean  @default(true) @map("is_active")
  msrpCents        Int?     @map("msrp_cents")
  streetPriceCents Int?     @map("street_price_cents")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  cpu              Cpu?
  gpu              Gpu?
  motherboard      Motherboard?
  ramKit           RamKit?
  storageDrive     StorageDrive?
  psu              Psu?
  pcCase           PcCase?
  cpuCooler        CpuCooler?
  fan              Fan?
  listings         Listing[]
  referenceBuilds  ReferenceBuildPart[]
  buildParts       BuildPart[]
  gameMinimums     GameMinimumPart[]
  softwareMinimums SoftwareMinimumPart[]

  @@map("pc_parts")
}

model Listing {
  id                 String    @id @default(uuid()) @db.Uuid
  partId             String    @map("part_id") @db.Uuid
  part               PcPart    @relation(fields: [partId], references: [id], onDelete: Cascade)
  listingType        String    @map("listing_type")
  marketplace        String
  url                String?
  priceAmount        Int?      @map("price_amount")
  currency           String?   @default("USD")
  imageUrl           String?   @map("image_url")
  isActive           Boolean   @default(true) @map("is_active")
  fetchedAt          DateTime? @map("fetched_at")
  priceLastUpdatedAt DateTime? @map("price_last_updated_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  amazonListing AmazonListing?

  @@map("listings")
}

model AmazonListing {
  id           String   @id @db.Uuid
  listing      Listing  @relation(fields: [id], references: [id], onDelete: Cascade)
  asin         String
  brand        String?  @map("brand")
  isPrime      Boolean? @map("is_prime")
  sellerName   String?  @map("seller_name")
  affiliateTag String?  @map("affiliate_tag")

  @@map("amazon_listings")
}

// Component groups — intrinsic spec shared across every purchasable variant of
// the same part. Standalone tables (no pc_parts row / price / listings); each
// exact PcPart subtype FKs its group.

model GpuChipset {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  streetPriceCents    Int?     @map("street_price_cents")
  vramGb              Int      @map("vram_gb")
  vramType            String?  @map("vram_type")
  tdpWatts            Int      @map("tdp_watts")
  recommendedPsuWatts Int?     @map("recommended_psu_watts")
  pcieGeneration      Int?     @map("pcie_generation")
  baseClockMhz        Int?     @map("base_clock_mhz")
  boostClockMhz       Int?     @map("boost_clock_mhz")
  hasRayTracing       Boolean  @default(false) @map("has_ray_tracing")
  cudaCores           Int?     @map("cuda_cores")
  tensorCores         Int?     @map("tensor_cores")
  streamProcessors    Int?     @map("stream_processors")
  matrixCores         Int?     @map("matrix_cores")
  supportedFeatures   String[] @map("supported_features")
  benchmarkScores     Json?    @map("benchmark_scores")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  variants Gpu[]

  @@map("gpu_chipsets")
}

model PsuGroup {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  streetPriceCents    Int?     @map("street_price_cents")
  wattage             Int
  formFactor          String   @map("form_factor")
  efficiencyRating    String   @map("efficiency_rating")
  modular             String?
  isFanless           Boolean  @default(false) @map("is_fanless")
  fanSizeMm           Int?     @map("fan_size_mm")
  pcie8pinConnectors  Int?     @map("pcie_8pin_connectors")
  pcie12pinConnectors Int?     @map("pcie_12pin_connectors")
  pcie16pinConnectors Int?     @map("pcie_16pin_connectors")
  epsConnectors       Int?     @map("eps_connectors")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  variants Psu[]

  @@map("psu_groups")
}

model RamGroup {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  streetPriceCents Int?     @map("street_price_cents")
  ddrGeneration    String   @map("ddr_generation")
  speedMhz         Int      @map("speed_mhz")
  capacityGb       Int      @map("capacity_gb")
  modules          Int
  moduleCapacityGb Int?     @map("module_capacity_gb")
  casLatency       Int?     @map("cas_latency")
  voltage          Float?
  isEcc            Boolean  @default(false) @map("is_ecc")
  // udimm | rdimm | lrdimm. Registered modules are a hard compatibility wall
  // on server platforms in both directions, which isEcc alone can't express
  // (ECC UDIMMs exist). Backfilled to udimm for every pre-existing kit.
  moduleType       String?  @map("module_type")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  variants RamKit[]

  @@map("ram_groups")
}

model StorageGroup {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  streetPriceCents Int?     @map("street_price_cents")
  storageType      String   @map("storage_type")
  formFactor       String   @map("form_factor")
  interface        String
  capacityGb       Int      @map("capacity_gb")
  readSpeedMbps    Int?     @map("read_speed_mbps")
  writeSpeedMbps   Int?     @map("write_speed_mbps")
  hasDramCache     Boolean  @default(false) @map("has_dram_cache")
  enduranceTbw     Int?     @map("endurance_tbw")
  rpm              Int?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  variants StorageDrive[]

  @@map("storage_groups")
}

model Cpu {
  id                String   @id @db.Uuid
  pcPart            PcPart   @relation(fields: [id], references: [id], onDelete: Cascade)
  brand             String?
  socket            String?
  tdpWatts          Int?     @map("tdp_watts")
  hasIgpu           Boolean  @default(false) @map("has_igpu")
  ddrGeneration     String[] @map("ddr_generation")
  supportedFeatures String[] @map("supported_features")
  benchmarkScores   Json?    @map("benchmark_scores")
  cores             Int?
  threads           Int?
  baseClockGhz      Float?   @map("base_clock_ghz")
  boostClockGhz     Float?   @map("boost_clock_ghz")
  l3CacheMb         Int?     @map("l3_cache_mb")
  pcieGeneration    Int?     @map("pcie_generation")
  maxMemoryGb       Int?     @map("max_memory_gb")
  series            String?
  // Server/workstation platform spec — what separates a Threadripper or Xeon
  // from a desktop part. Nullable means "not recorded", not "no".
  pcieLanes         Int?     @map("pcie_lanes")
  memoryChannels    Int?     @map("memory_channels")
  supportsEcc       Boolean? @map("supports_ecc")

  @@map("cpus")
}

model Gpu {
  id             String     @id @db.Uuid
  pcPart         PcPart     @relation(fields: [id], references: [id], onDelete: Cascade)
  gpuChipsetId   String     @map("gpu_chipset_id") @db.Uuid
  chipset        GpuChipset @relation(fields: [gpuChipsetId], references: [id])
  brand          String
  lengthMm       Int        @map("length_mm")
  widthSlots     Float?     @map("width_slots")
  pciePowerPins  String?    @map("pcie_power_pins")
  displayOutputs String?    @map("display_outputs")
  hdmiVersion    String?    @map("hdmi_version")
  dpVersion      String?    @map("dp_version")

  @@map("gpus")
}

model Motherboard {
  id             String  @id @db.Uuid
  pcPart         PcPart  @relation(fields: [id], references: [id], onDelete: Cascade)
  socket         String?
  formFactor     String? @map("form_factor")
  ddrGeneration  String? @map("ddr_generation")
  memorySlots    Int?    @map("memory_slots")
  hasWifi        Boolean @default(false) @map("has_wifi")
  m2Slots        Int?    @map("m2_slots")
  m2PcieGen      Int?    @map("m2_pcie_gen")
  chipset        String?
  maxMemoryGb    Int?    @map("max_memory_gb")
  sataPorts      Int?    @map("sata_ports")
  pcieX16Slots   Int?    @map("pcie_x16_slots")
  pcieGeneration Int?    @map("pcie_generation")
  hasBluetooth   Boolean @default(false) @map("has_bluetooth")
  usbTypeACount  Int?    @map("usb_type_a_count")
  usbTypeCCount  Int?    @map("usb_type_c_count")
  audioCodec     String? @map("audio_codec")
  // Server-board spec. hasIpmi is the clearest single signal that a board is a
  // server board rather than a workstation board.
  supportsEcc    Boolean? @map("supports_ecc")
  hasIpmi        Boolean? @map("has_ipmi")
  memoryChannels Int?     @map("memory_channels")
  // Empty = unconstrained. Populated is what stops a TRX50/WRX90 board being
  // paired with unbuffered kits it will not POST on.
  memoryModuleTypes String[] @map("memory_module_types")

  @@map("motherboards")
}

model RamKit {
  id         String   @id @db.Uuid
  pcPart     PcPart   @relation(fields: [id], references: [id], onDelete: Cascade)
  ramGroupId String   @map("ram_group_id") @db.Uuid
  group      RamGroup @relation(fields: [ramGroupId], references: [id])
  heightMm   Int?     @map("height_mm")
  hasRgb     Boolean  @default(false) @map("has_rgb")

  @@map("ram_kits")
}

model StorageDrive {
  id             String       @id @db.Uuid
  pcPart         PcPart       @relation(fields: [id], references: [id], onDelete: Cascade)
  storageGroupId String       @map("storage_group_id") @db.Uuid
  group          StorageGroup @relation(fields: [storageGroupId], references: [id])

  @@map("storage_drives")
}

model Psu {
  id         String   @id @db.Uuid
  pcPart     PcPart   @relation(fields: [id], references: [id], onDelete: Cascade)
  psuGroupId String   @map("psu_group_id") @db.Uuid
  group      PsuGroup @relation(fields: [psuGroupId], references: [id])
  depthMm    Int?     @map("depth_mm")

  @@map("psus")
}

model PcCase {
  id                       String   @id @db.Uuid
  pcPart                   PcPart   @relation(fields: [id], references: [id], onDelete: Cascade)
  supportedMoboFormFactors String[] @map("supported_mobo_form_factors")
  maxGpuLengthMm           Int?     @map("max_gpu_length_mm")
  maxCoolerHeightMm        Int?     @map("max_cooler_height_mm")
  maxRadiatorFrontMm       Int?     @map("max_radiator_front_mm")
  maxRadiatorTopMm         Int?     @map("max_radiator_top_mm")
  maxPsuLengthMm           Int?     @map("max_psu_length_mm")
  includedFanCount         Int?     @map("included_fan_count")
  chamberCount             Int?     @map("chamber_count")
  frontPanelMesh           Boolean  @default(false) @map("front_panel_mesh")
  color                    String?
  size                     String?
  driveBays35              Int?     @map("drive_bays_35")
  driveBays25              Int?     @map("drive_bays_25")
  maxFanSlots              Int?     @map("max_fan_slots")
  hasGlassPanel            Boolean  @default(false) @map("has_glass_panel")
  weightKg                 Float?   @map("weight_kg")
  lengthMm                 Int?     @map("length_mm")
  widthMm                  Int?     @map("width_mm")
  heightMm                 Int?     @map("height_mm")
  usbFrontTypeA            Int?     @map("usb_front_type_a")
  usbFrontTypeC            Int?     @map("usb_front_type_c")

  @@map("cases")
}

model CpuCooler {
  id               String   @id @db.Uuid
  pcPart           PcPart   @relation(fields: [id], references: [id], onDelete: Cascade)
  supportedSockets String[] @map("supported_sockets")
  coolerType       String?  @map("cooler_type")
  maxTdpWatts      Int?     @map("max_tdp_watts")
  heightMm         Int?     @map("height_mm")
  radiatorSizeMm   Int?     @map("radiator_size_mm")
  fanCount         Int?     @map("fan_count")
  fanSizeMm        Int?     @map("fan_size_mm")
  noiseDba         Float?   @map("noise_dba")
  hasRgb           Boolean  @default(false) @map("has_rgb")

  @@map("cpu_coolers")
}

model Fan {
  id               String  @id @db.Uuid
  pcPart           PcPart  @relation(fields: [id], references: [id], onDelete: Cascade)
  sizeMm           Int?    @map("size_mm")
  maxRpm           Int?    @map("max_rpm")
  airflowCfm       Float?  @map("airflow_cfm")
  noiseDba         Float?  @map("noise_dba")
  isPwm            Boolean @default(false) @map("is_pwm")
  hasRgb           Boolean @default(false) @map("has_rgb")
  bearingType      String? @map("bearing_type")
  isStaticPressure Boolean @default(false) @map("is_static_pressure")
  packCount        Int?    @map("pack_count")

  @@map("fans")
}

// pc_builds and pc_build_parts are managed by the backend (Alembic).
// role/status are native Postgres enums (build_component_role, build_status) — mapped
// to real Prisma enums below so Prisma casts writes correctly instead of sending text.
enum BuildComponentRole {
  cpu
  cpucooler
  motherboard
  ram
  storage
  gpu
  psu
  case
  fan

  @@map("build_component_role")
}

enum BuildStatus {
  draft
  recommended
  priced
  finalized
  ordered

  @@map("build_status")
}

model PCBuild {
  id                   String      @id @default(uuid()) @db.Uuid
  name                 String      @default("Untitled Build")
  description          String?
  ownerId              String?     @map("owner_id") @db.Uuid
  status               BuildStatus @default(draft)
  totalPriceCents      Int?        @map("total_price_cents")
  useCases             String[]    @map("use_cases")
  preferences          Json?
  questionnaireAnswers Json?       @map("questionnaire_answers")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  parts          BuildPart[]
  referenceBuild ReferenceBuild?

  @@map("pc_builds")
}

// One row per DISTINCT part in a role; identical units are one row with
// quantity > 1. gpu/storage/fan may repeat within a build, every other role
// may not.
//
// That narrowing is enforced by two partial unique indexes and two check
// constraints which, like the discovery ones above, are not expressible in
// Prisma and live only in the DB (see the b3d5e7f9a1c2 migration):
//   - UNIQUE (build_id, role) WHERE role NOT IN ('fan','gpu','storage')
//   - UNIQUE (build_id, role, part_id) WHERE part_id IS NOT NULL
//   - quantity >= 1, and quantity = 1 for the singleton roles
// The plain @@unique that used to sit here is gone for the same reason: it
// would describe a constraint the database no longer has.
model BuildPart {
  id                String             @id @default(uuid()) @db.Uuid
  buildId           String             @map("build_id") @db.Uuid
  partId            String?            @map("part_id") @db.Uuid
  role              BuildComponentRole
  requiredComponent Boolean            @default(false) @map("required_component")
  quantity          Int                @default(1)
  // PER-UNIT price; the line total is priceAtBuild * quantity.
  priceAtBuild      Int?               @map("price_at_build")
  selectionReason   String?            @map("selection_reason")
  createdAt         DateTime           @default(now()) @map("created_at")

  build PCBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)
  part  PcPart? @relation(fields: [partId], references: [id])

  @@map("pc_build_parts")
}

model ReferenceBuild {
  id            String   @id @default(uuid()) @db.Uuid
  buildKey      String   @unique @map("build_key")
  label         String
  description   String?
  totalApprox   Int?     @map("total_approx")
  isActive      Boolean  @default(true) @map("is_active")
  maxResolution Int?     @map("max_resolution")
  pcBuildId     String?  @unique @map("pc_build_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  pcBuild PCBuild?             @relation(fields: [pcBuildId], references: [id])
  parts   ReferenceBuildPart[]

  @@map("reference_builds")
}

model ReferenceBuildPart {
  id                   String    @id @default(uuid()) @db.Uuid
  buildId              String    @map("build_id") @db.Uuid
  partId               String    @map("part_id") @db.Uuid
  component            String
  sortOrder            Int       @default(0) @map("sort_order")
  approxPrice          Int       @map("approx_price")
  approxPriceUpdatedAt DateTime? @map("approx_price_updated_at")

  build ReferenceBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)
  part  PcPart         @relation(fields: [partId], references: [id])

  @@map("reference_build_parts")
}

model User {
  id          String   @id @db.Uuid
  email       String   @unique
  username    String?
  firebaseUid String?  @map("firebase_uid")
  isActive    Boolean  @default(true) @map("is_active")
  isSuperuser Boolean  @default(false) @map("is_superuser")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Conversation {
  id                    String    @id @db.Uuid
  userId                String?   @map("user_id") @db.Uuid
  buildId               String?   @map("build_id") @db.Uuid
  title                 String?
  summary               String?
  totalCostUsd          Decimal   @default(0) @map("total_cost_usd") @db.Decimal
  totalTokensIn         Int       @default(0) @map("total_tokens_in")
  totalTokensOut        Int       @default(0) @map("total_tokens_out")
  llmCallCount          Int       @default(0) @map("llm_call_count")
  modelsUsed            String[]  @default([]) @map("models_used")
  reachedRecommendation Boolean   @default(false) @map("reached_recommendation")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  messages              Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String
  content        String?
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("messages")
}

enum BuildSessionStatus {
  running
  completed
  abandoned
  error

  @@map("build_session_status")
}

// DSPy recommender telemetry — one row per pipeline run (the GEPA cohort).
// Populated once the component pipeline is wired to a live route.
model BuildSession {
  id                         String             @id @db.Uuid
  userId                     String?            @map("user_id") @db.Uuid
  pipelineVersion            String             @map("pipeline_version")
  budgetCents                Int?               @map("budget_cents")
  priceSensitivity           String?            @map("price_sensitivity")
  inputProfile               Json               @map("input_profile")
  finalBuild                 Json?              @map("final_build")
  totalCostUsd               Decimal?           @map("total_cost_usd") @db.Decimal
  totalLatencyMs             Int?               @map("total_latency_ms")
  budgetDeltaCents           Int?               @map("budget_delta_cents")
  compatibilityOverrideCount Int                @default(0) @map("compatibility_override_count")
  status                     BuildSessionStatus @default(running)
  createdAt                  DateTime           @default(now()) @map("created_at")
  updatedAt                  DateTime           @updatedAt @map("updated_at")
  decisions                  ModuleDecision[]

  @@map("build_sessions")
}

// One row per Decide* call — the GEPA training example.
model ModuleDecision {
  id               String       @id @db.Uuid
  sessionId        String       @map("session_id") @db.Uuid
  session          BuildSession @relation(fields: [sessionId], references: [id])
  pipelineVersion  String       @map("pipeline_version")
  category         String
  sequenceOrder    Int          @map("sequence_order")
  signatureName    String       @map("signature_name")
  signatureVersion Int          @map("signature_version")
  candidateSet     Json?        @map("candidate_set")
  inputState       Json?        @map("input_state")
  rawPromptHash    String?      @map("raw_prompt_hash")
  outputDecision   Json?        @map("output_decision")
  tokensIn         Int?         @map("tokens_in")
  tokensOut        Int?         @map("tokens_out")
  costUsd          Decimal?     @map("cost_usd") @db.Decimal
  latencyMs        Int?         @map("latency_ms")
  wasOverride      Boolean      @default(false) @map("was_override")
  modelName        String?      @map("model_name")
  outcomeSignal    Json?        @map("outcome_signal")
  createdAt        DateTime     @default(now()) @map("created_at")

  @@index([category, pipelineVersion, createdAt], map: "ix_module_decisions_category_pipeline_created")
  @@map("module_decisions")
}

// --- Games catalog ---

model Game {
  id                String   @id @default(uuid()) @db.Uuid
  title             String   @unique
  slug              String   @unique
  genre             String?
  storeUrl          String?  @map("store_url")
  imageUrl          String?  @map("image_url")
  hardRequirements  String[] @map("hard_requirements")
  minStorageGb      Int?     @map("min_storage_gb")
  requirementsNotes String?  @map("requirements_notes")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  minimumParts GameMinimumPart[]

  @@map("games")
}

model GameMinimumPart {
  id            String   @id @default(uuid()) @db.Uuid
  gameId        String   @map("game_id") @db.Uuid
  tier          String // minimum | recommended | ultra
  role          String // cpu | gpu
  partId        String?  @map("part_id") @db.Uuid
  publishedName String?  @map("published_name")
  minRamGb      Int?     @map("min_ram_gb")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  game Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  part PcPart? @relation(fields: [partId], references: [id])

  @@unique([gameId, tier, role], map: "uq_game_min_parts_game_tier_role")
  @@map("game_minimum_parts")
}

// --- Software catalog ---

model Software {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String   @unique
  slug                 String   @unique
  category             String // creative | productivity | ai_ml | development | streaming
  useCaseTags          String[] @map("use_case_tags")
  developer            String?
  currentVersion       String?  @map("current_version")
  websiteUrl           String?  @map("website_url")
  imageUrl             String?  @map("image_url")
  isFree               Boolean? @map("is_free")
  platformRequirements String[] @map("platform_requirements")
  notes                String?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tiers SoftwareTier[]

  @@map("software")
}

model SoftwareTier {
  id                  String   @id @default(uuid()) @db.Uuid
  softwareId          String   @map("software_id") @db.Uuid
  name                String
  slug                String
  sortOrder           Int      @default(0) @map("sort_order")
  gpuImportance       String   @default("optional") @map("gpu_importance") // required | accelerated | optional | irrelevant
  minRamGb            Int?     @map("min_ram_gb")
  recommendedRamGb    Int?     @map("recommended_ram_gb")
  minVramGb           Int?     @map("min_vram_gb")
  minStorageGb        Int?     @map("min_storage_gb")
  minCores            Int?     @map("min_cores")
  prefersSingleThread Boolean? @map("prefers_single_thread")
  extraRequirements   Json?    @map("extra_requirements")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  software     Software              @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  minimumParts SoftwareMinimumPart[]

  @@unique([softwareId, slug], map: "uq_software_tiers_software_slug")
  @@map("software_tiers")
}

model SoftwareMinimumPart {
  id            String   @id @default(uuid()) @db.Uuid
  tierId        String   @map("tier_id") @db.Uuid
  role          String // cpu | gpu
  partId        String?  @map("part_id") @db.Uuid
  publishedName String?  @map("published_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tier SoftwareTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  part PcPart?      @relation(fields: [partId], references: [id])

  @@unique([tierId, role], map: "uq_software_min_parts_tier_role")
  @@map("software_minimum_parts")
}

// --- AI catalog ---
// One AiModel row per catalog model; one AiWorkload row per
// (model x task x precision) cell — see backend app/models/ai_catalog.py.

model AiModel {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique
  slug           String   @unique
  family         String // llm | multimodal | image_gen | video_gen | speech | audio_gen | vision | embedding | classical | rl
  paramsBillions Float?   @map("params_billions")
  contextLength  Int?     @map("context_length")
  developer      String?
  license        String?
  huggingfaceId  String?  @map("huggingface_id")
  websiteUrl     String?  @map("website_url")
  imageUrl       String?  @map("image_url")
  spec           Json?
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  workloads AiWorkload[]

  @@map("ai_models")
}

model AiWorkload {
  id                  String   @id @default(uuid()) @db.Uuid
  modelId             String   @map("model_id") @db.Uuid
  task                String // inference | fine_tune_full | fine_tune_lora | fine_tune_qlora | post_train | train_scratch
  precision           String // fp32 | bf16 | fp16 | fp8 | int8 | q8..q3 | ...
  gpuImportance       String   @default("required") @map("gpu_importance")
  minVramGb           Int?     @map("min_vram_gb") // total across GPUs; NULL = no GPU needed
  recommendedVramGb   Int?     @map("recommended_vram_gb")
  supportsMultiGpu    Boolean  @default(false) @map("supports_multi_gpu")
  cpuOffloadCapable   Boolean  @default(false) @map("cpu_offload_capable")
  minRamGb            Int?     @map("min_ram_gb")
  recommendedRamGb    Int?     @map("recommended_ram_gb")
  minStorageGb        Int?     @map("min_storage_gb")
  gpuBackends         String[] @default(["cuda"]) @map("gpu_backends")
  requiredGpuFeatures String[] @map("required_gpu_features")
  assumptions         Json?
  extraRequirements   Json?    @map("extra_requirements")
  sortOrder           Int      @default(0) @map("sort_order")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  model AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, task, precision], map: "uq_ai_workloads_model_task_precision")
  @@map("ai_workloads")
}

// Parts-discovery staging — managed by the backend (Alembic); mirror only,
// never prisma migrate. The partial unique index on discovered_items
// (category, name_normalized) WHERE review_status='pending' is not
// expressible in Prisma and lives only in the DB.

model DiscoveryRun {
  id              String    @id @default(uuid()) @db.Uuid
  runType         String    @map("run_type") // hardware | ai_models | on_demand
  status          String    @default("running") // running | completed | error
  pipelineVersion String    @map("pipeline_version")
  modelName       String    @map("model_name")
  sourcesChecked  Int       @default(0) @map("sources_checked")
  itemsFound      Int       @default(0) @map("items_found")
  itemsNew        Int       @default(0) @map("items_new")
  errorDetail     String?   @map("error_detail")
  totalCostUsd    Decimal?  @map("total_cost_usd") @db.Decimal(10, 6)
  tokensIn        Int?      @map("tokens_in")
  tokensOut       Int?      @map("tokens_out")
  startedAt       DateTime  @default(now()) @map("started_at")
  finishedAt      DateTime? @map("finished_at")

  items DiscoveredItem[]

  @@map("discovery_runs")
}

model DiscoverySource {
  id              String    @id @default(uuid()) @db.Uuid
  url             String
  category        String
  isActive        Boolean   @default(true) @map("is_active")
  lastFetchedAt   DateTime? @map("last_fetched_at")
  lastContentHash String?   @map("last_content_hash")

  @@map("discovery_sources")
}

model DiscoveredItem {
  id                   String       @id @default(uuid()) @db.Uuid
  runId                String       @map("run_id") @db.Uuid
  run                  DiscoveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  category             String // cpu | gpu_chipset | gpu_variant | motherboard | cpu_cooler | ram_kit | storage_drive | psu | case | fan | ai_model
  nameNormalized       String       @map("name_normalized")
  modelNumber          String?      @map("model_number")
  extractedFields      Json         @map("extracted_fields")
  fieldProvenance      Json         @map("field_provenance")
  extractionConfidence Json?        @map("extraction_confidence")
  sourceUrls           String[]     @map("source_urls")
  // Plain uuid fields, not relations — keeps PcPart/GpuChipset free of
  // discovery back-relations; the queue page resolves names itself.
  matchedPartId        String?      @map("matched_part_id") @db.Uuid
  matchedChipsetId     String?      @map("matched_chipset_id") @db.Uuid
  // ai_models is a standalone catalog, not a pc_parts subtype, so AI-model
  // matches and audit links need their own columns.
  matchedAiModelId     String?      @map("matched_ai_model_id") @db.Uuid
  matchMethod          String?      @map("match_method") // exact | model_number | fuzzy | embedding
  matchScore           Float?       @map("match_score")
  validationStatus     String       @map("validation_status") // passed | failed
  validationErrors     Json?        @map("validation_errors")
  reviewStatus         String       @default("pending") @map("review_status") // pending | approved | rejected | duplicate
  reviewedAt           DateTime?    @map("reviewed_at")
  createdPartId        String?      @map("created_part_id") @db.Uuid
  createdChipsetId     String?      @map("created_chipset_id") @db.Uuid
  createdAiModelId     String?      @map("created_ai_model_id") @db.Uuid
  createdAt            DateTime     @default(now()) @map("created_at")

  @@map("discovered_items")
}
